# ── Google API ──
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
GOOGLE_SERVICE_ACCOUNT_EMAIL=soullogic-bot@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxx\n-----END PRIVATE KEY-----"
GOOGLE_SPREADSHEET_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ
GOOGLE_DRIVE_ROOT_FOLDER_ID=1xxxxx

# ── Auth ──
NEXTAUTH_URL=https://app.soullogic.ai
NEXTAUTH_SECRET=xxxxx

# ── Anthropic (Claude AI) ──
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── OpenAI (Whisper STT) ──
OPENAI_API_KEY=sk-xxxxx

# ── OpenClaw (Multi-Platform Chat) ──
OPENCLAW_API_KEY=xxxxx
OPENCLAW_WEBHOOK_SECRET=whsec_xxxxx
OPENCLAW_BOT_ID=bot_xxxxx

# ── Email ──
GMAIL_MONITOR_ADDRESS=invoices@soullogic.ai

# ── App ──
DEFAULT_CURRENCY=CAD
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=America/Toronto
APP_URL=https://app.soullogic.ai
